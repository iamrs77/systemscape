{
	"name": "systemscape",
	"version": "0.1.0",
	"private": true,
	"description": "Explore how large systems are built, in 3D: watch requests flow, push the traffic, break things and fix them.",
	"author": "Rohit Sharma",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"three": "^0.187.0",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.187.0",
		"@vitejs/plugin-react": "^6.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.8",
		"globals": "^17.14.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.10.1",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
